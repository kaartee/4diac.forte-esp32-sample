#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		/* led0 is already aliased to green_led (Teensy Pin 13) in teensy4x.dtsi */
		sw0 = &user_button0;
		pwm0 = &flexpwm2_pwm0;
		watchdog0 = &wdog1;
	};

	buttons {
		compatible = "gpio-keys";
		user_button0: button_0 {
			gpios = <&gpio4 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User Button0 (Teensy Pin 2)";
		};
	};

	zephyr,user {
		io-channels = <&adc1 0>;
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&flexpwm2_pwm0 {
	status = "okay";
};

&wdog1 {
	status = "okay";
};

&enet {
	status = "okay";
};

&w25q64jvssiq {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Reserve top 512 KB of 8 MB QSPI flash (0x780000..0x800000) for LittleFS */
		lfs_partition: partition@780000 {
			label = "lfs_storage";
			reg = <0x00780000 0x00080000>;
		};
	};
};
